# ==============================================================================
# AI Newsletter & Intelligence Platform - Environment Configuration
# ==============================================================================

# Database
DB_PATH=data/ai_newsletter.db

# Timezone & Schedule
NEWSLETTER_TIMEZONE=Asia/Seoul
DAILY_COLLECTION_TIME=07:00
ENABLE_DAILY_SCHEDULER=true

# Language Settings
DEFAULT_LANGUAGE=ko

# Network & TLS
VERIFY_TLS=true
REQUEST_TIMEOUT_SECONDS=12.0
MAX_ENTRIES_PER_FEED=15

# Summarization Engine (Ollama Local LLM or Template Fallback)
ENABLE_AI_SUMMARY=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=30.0

# SMTP / Email Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=AI Newsletter <your-email@gmail.com>
NEWSLETTER_TO=recipient1@example.com,recipient2@example.com
SMTP_TLS=true

# Web Server & Authentication
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-in-production
FORWARDED_ALLOW_IPS=*
